# Optional private reference: copy to .env and export values in your shell.
# Python does NOT automatically load .env. See README for each platform.
SMARTPHSET_BACKEND_URL=http://localhost:9090
SMARTPHSET_AI_INGEST_KEY=YOUR_PRIVATE_AI_KEY
# Only required for optional photo bridge / hosted model:
BRIDGE_API_KEY=YOUR_PRIVATE_BRIDGE_KEY
ROBOFLOW_API_KEY=
# Optional bridge overrides; blank uses repository defaults.
SMARTPHSET_WEIGHTS=
SMARTPHSET_LOG_DIR=

# Persistent multi-session service (export explicitly; never put keys in client code).
SMARTPHSET_AI_SERVICE_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
SMARTPHSET_AI_MAX_SESSIONS=16
SMARTPHSET_CONFIDENCE=0.4
# Operator allowlist: IDs must also appear in Spring's registry. Empty is browser-only.
# Example without private addresses: '{"worker-usb":0}'
SMARTPHSET_CAMERA_SOURCES='{}'
